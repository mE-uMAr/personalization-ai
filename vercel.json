{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://personalization-ai-ee3dea7b.fastapicloud.dev/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
